# --- Phase 1 ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
APP_VERSION=1.0.0

# --- Phase 2: PostgreSQL & Redis (local for now) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prepjee
REDIS_URL=redis://localhost:6379

# --- Phase 4: Auth ---
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Google login (ID-token verification) — leave blank until we wire it up
GOOGLE_CLIENT_ID=

# --- Phase 5: Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Phase 16: Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Amplitude (Phase 1 setup, used from Phase 4 onward) ---
AMPLITUDE_API_KEY=
