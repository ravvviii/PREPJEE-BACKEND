# --- Phase 1 ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
APP_VERSION=1.0.0

# --- Phase 2: PostgreSQL & Redis (local for now) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prepjee
REDIS_URL=redis://localhost:6379

# --- Phase 4: Auth ---
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
ADMIN_JWT_EXPIRY=12h

# Trusted Postman/automation access to /internal/* routes.
# Generate a random value of at least 32 characters and never expose it in frontend code.
INTERNAL_API_KEY= a5c1814c475f3c6ca5adc20b33cae4993376c7b2913dc8432cc1fb150932b0db

# Google OAuth Client ID — POST /auth/google verifies ID tokens against this.
# Optional: leave blank to disable Google sign-in (that one endpoint 503s,
# everything else works fine).
GOOGLE_CLIENT_ID=

# --- Phase 5: Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Phase 16: Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Amplitude (Phase 1 setup, used from Phase 4 onward) ---
AMPLITUDE_API_KEY=
